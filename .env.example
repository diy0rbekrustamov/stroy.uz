# Copy to .env (never commit real credentials).
# Use either a PostgreSQL server or API_EMBEDDED_DB=1 for local development.
APP_ORIGIN=http://127.0.0.1:5173
API_PORT=3001
TRUST_PROXY_HOPS=0
# DATABASE_URL=postgresql://stroy:change-me@127.0.0.1:5432/stroy
API_EMBEDDED_DB=1
API_DATA_DIR=.data/postgres
# Frontend examples are enabled in development by default; always disable before launch.
# VITE_DEMO_CATALOG=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
